# انسخ هذا الملف باسم .env واملأ القيم

# من @BotFather في تيليجرام
TELEGRAM_BOT_TOKEN=

# رمز تسجيل هاتف الشرطة لتلقي التنبيهات: /police 2026
POLICE_PIN=2026

# ---- النموذج اللغوي (اختياري) ----
# اتركها فارغة لتعمل الشخصيات بنصوص جاهزة دون إنترنت.
# أي واجهة متوافقة مع OpenAI تعمل، أمثلة:
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama محلي: LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY يُترك فارغاً)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=25

# لوحة التحكم
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# 1 = تأخير كتابة طبيعي قبل كل رد، 0 = رد فوري
TYPING_DELAY=1
